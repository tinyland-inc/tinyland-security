{
  "name": "@tummycrypt/tinyland-security",
  "version": "1.1.1",
  "private": true,
  "description": "IP hashing, encryption, risk scoring, device detection, VPN detection, rate limiting, timing-safe utilities, flat-file IP ban management and threat correlation",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ip-bans": {
      "types": "./dist/ip-bans/index.d.ts",
      "import": "./dist/ip-bans/index.js"
    },
    "./threat-detection": {
      "types": "./dist/threat-detection/index.d.ts",
      "import": "./dist/threat-detection/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "security",
    "ip-hashing",
    "rate-limiting",
    "device-detection",
    "vpn-detection",
    "risk-scoring",
    "fingerprint",
    "timing-safe",
    "ip-bans",
    "threat-detection",
    "impossible-travel",
    "ip-rotation",
    "threat-correlation"
  ],
  "author": "Tinyland.dev",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-security.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^22.20.5",
    "fast-check": "^4.3.0",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@maxmind/geoip2-node": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@maxmind/geoip2-node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-security",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-security/issues"
  }
}
